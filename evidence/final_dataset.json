  "policies": [
    {
      "content_anchors_present": true,
      "path": "knowledge_base/01_ticket_priority.md",
      "required_content_anchors": [
        "P1",
        "P2",
        "P3",
        "P4",
        "highest priority"
      ],
      "sentence_count": 4,
      "sentences": [
        "Assign P1 priority when a report describes an immediate safety concern or a widespread inability to use the ride service.",
        "Assign P2 priority to a blocked account or an incorrect charge that prevents a rider or driver from continuing normal service use.",
        "Assign P3 priority to a nonblocking technical issue or product defect, and assign P4 priority to a general inquiry or feedback request.",
        "When several conditions apply, record the highest priority and the facts that justify it without treating VIP status as a safety severity."
      ],
      "sha256": "bab83b53eab4704bfae1d10f133dec0e0742ad63dc2032d02bc7ae48eb082554",
      "topic": "ticket-priority classification rules"
    },
    {
      "content_anchors_present": true,
      "path": "knowledge_base/02_severity_sla.md",
      "required_content_anchors": [
        "15 elapsed minutes",
        "24 support hours",
        "72 support hours",
        "120 support hours"
      ],
      "sentence_count": 4,
      "sentences": [
        "For P1 severity, acknowledge within 15 elapsed minutes and target resolution or a documented workaround within 4 elapsed hours.",
        "For P2 severity, acknowledge within 1 support hour and target resolution within 24 support hours.",
        "For P3 severity, acknowledge within 4 support hours and target resolution within 72 support hours; for P4 severity, acknowledge within 8 support hours and target resolution within 120 support hours.",
        "These SLA targets use the business-hours policy for support-hour calculations and require an update before a deadline is missed, while external dependencies must be documented rather than presented as guaranteed completion times."
      ],
      "sha256": "99253eaf449ee424badaaea911f3626f7a6264b873904aa331830a360cfdb112",
      "topic": "SLA-by-severity policy"
    },
    {
      "content_anchors_present": true,
      "path": "knowledge_base/03_escalation_matrix.md",
      "required_content_anchors": [
        "billing specialist",
        "technical specialist",
        "account-security specialist",
        "duty incident lead",
        "handoff"
      ],
      "sentence_count": 4,
      "sentences": [
        "Route billing and refund disputes to the billing specialist, technical issues and product defects to the technical specialist, and account-access failures to the account-security specialist.",
        "Escalate a P1 safety report immediately to the duty incident lead, who coordinates the responsible specialist and emergency guidance when appropriate.",
        "Escalate a P2 ticket to the support supervisor if its acknowledgement deadline is missed, and escalate any unresolved ticket before its resolution target expires.",
        "The receiving owner must accept the handoff, and the original owner remains responsible for customer updates until acceptance is recorded."
      ],
      "sha256": "b47244736ab5ce7ecb71883de250bd4360606ce957a06cf5aa4479e1ad058816",
      "topic": "escalation matrix"
    },
    {
      "content_anchors_present": true,
      "path": "knowledge_base/04_refund_compensation.md",
      "required_content_anchors": [
        "duplicate charge",
        "original payment method",
        "5 to 7 business days",
        "INR 200",
        "approval"
      ],
      "sentence_count": 4,
      "sentences": [
        "A billing specialist may approve a refund after verifying a duplicate charge, a confirmed overcharge, or a charge for a service that was not delivered.",
        "Refund only the verified incorrect amount to the original payment method, with a target processing time of 5 to 7 business days after approval.",
        "A support supervisor may approve goodwill compensation up to INR 200 for a documented service failure, while larger compensation requires the operations manager's approval.",
        "Do not promise a refund or compensation before approval, and record whether a service credit already covers the same loss to prevent duplicate reimbursement."
      ],
      "sha256": "4275edaebc7852ced642d0b00f164ce2659bb0459a1a4960b78dd861e2f91586",
      "topic": "refund/compensation policy"
    },
    {
      "content_anchors_present": true,
      "path": "knowledge_base/05_communication_channels.md",
      "required_content_anchors": [
        "in-app support",
        "email",
        "consents",
        "account-verification",
        "password"
      ],
      "sentence_count": 4,
      "sentences": [
        "Use in-app support as the primary communication channel for rider and driver ticket updates, with email as the alternative when account access is unavailable.",
        "A support agent may offer a callback for an urgent issue only after the customer requests or consents to the call.",
        "Before sharing ticket details on an alternative channel, complete the approved account-verification process and avoid exposing another customer's information.",
        "Never request an OTP, full payment-card details, or an account password, and keep every customer update attached to the ticket record."
      ],
      "sha256": "b9f430e54066d13b30396e2feac128652da6ccf5ad3f3c44d1cad585e82320f1",
      "topic": "customer-communication-channel policy"
    },
    {
      "content_anchors_present": true,
      "path": "knowledge_base/06_business_hours.md",
      "required_content_anchors": [
        "09:00 to 18:00",
        "Asia/Kolkata",
        "holidays",
        "on-call",
        "pause"
      ],
      "sentence_count": 4,
      "sentences": [
        "Standard support hours are 09:00 to 18:00 Asia/Kolkata from Monday through Saturday, excluding holidays listed in the team's published support calendar.",
        "Support-hour SLA clocks pause outside those hours and resume at the next opening, while business-day refund processing uses Monday through Friday excluding listed holidays.",
        "P1 safety and major-outage reports reach the on-call team at all times, including Sundays and holidays, and use elapsed-time SLA clocks.",
